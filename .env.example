# Optional: copy this file to .env and fill values.
DIGEST_OUTPUT_DIR=output
DIGEST_LOOKBACK_HOURS=48
REQUEST_TIMEOUT_SECONDS=15

# Optional email delivery. If SMTP_HOST or recipients are empty, email is skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
EMAIL_TO=
EMAIL_SUBJECT_PREFIX=每日中文主题摘要
